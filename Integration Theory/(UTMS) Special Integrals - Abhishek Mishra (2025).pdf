\\left\(y e^{i \\theta} \\right\) + g\\left\(y e^{-i \\theta} \\right\) \\right\)\ \\, d \\theta \\\\ &= & -a_0 b_0 + \\frac{1}{\\pi} \\int_0^{\\pi} \\left\( \\sum_{k = 0}^{\\infty} a_k b_k \(1 + \\cos 2k \\theta\) z^k \\right\) \\, d \\theta \\\\ && \\quad + \\frac{1}{\\pi} \\int_0^{\\pi} \\left\( \\sum_{k = 0}^{\\infty} \\sum_{j = 0,\ j \\neq k}^{\\infty} a_k b_j \(\\cos \(k + j\) \\theta + \\cos \(k - j\) \\theta\) x^k y^j \\right\) \\, d \\theta \\\\ &= & -a_0 b_0 + \\frac{1}{\\pi} \\sum_{k = 0}^{\\infty} a_k b_k z^k \\int_0^{\\pi} \(1 + \\cos 2k \\theta\) d \\theta \\\\ && \\quad +\ \\frac{1}{\\pi} \\sum_{k = 0}^{\\infty} \\sum_{j = 0, j \\neq k}^{\\infty} a_k b_j x^k y^j \\int_0^{\\pi} \(\\cos \(k + j\) \\theta + \\cos \(k - j\) \\theta\) \\, d \\theta \\\\ &= & -a_0 b_0 + \\left. \\frac{a_0 b_0}{\\pi} \\left\( 2 \\theta \\right\) \\\right |_0^\\pi + \\frac{1}{\\pi} \\sum_{k = 1}^{\\infty} a_k b_k z^k \\left. \\left\( \\theta + \\frac{\\sin 2k \\theta}{2k} \\right\) \\right |_0^{\\pi} \\\\ && \\quad + \\frac{1}{\\pi} \\sum_{k = 0}^{\\infty} \\sum_{j = 0, j \\neq k}^{\\infty} a_k b_j\ x^k y^j \\left. \\left\( \\frac{\\sin \(k + j\) \\theta}{k + j} + \\frac{\\sin \(k - j\) \\theta}{k - j} \\right\) \\right |_0^{\\pi} \\\\ &= & \\sum_{k = 0}^{\\infty} a_k b_k z^k \\\\ &= & \(f \\star g\) \(z\).\\eUnALT{} )/Border[0 0 0]/K 93/P 13111 0 R/Pg 653 0 R/S/P/Type/StructElem>>endobj13262 0 obj<</K 0/P 13111 0 R/Pg 656 0 R/S/P/Type/StructElem>>endobj13263 0 obj<</K 4/P 13111 0 R/Pg 656 0 R/S/P/Type/StructElem>>endobj13264 0 obj<</K[5 13287 0 R 8 13288 0 R 11 13289 0 R 13 13290 0 R 16 13291 0 R 19 13292 0 R 22 13293 0 R 25 13294 0 R 28 13295 0 R 31 13296 0 R 34]/P 13111 0 R/Pg 656 0 R/S/P/Type/StructElem>>endobj13265 0 obj<</ActualText(\\bUnALT{} \(f \\star g\)\(z\) = f\(0\)g\(0\) - \\frac{1}{2 \\pi} \\int_0^{\\pi} \\left\( f\\left\(x e^{i \\theta} \\right\) - f\\left\(x e^{-i \\theta} \\right\) \\right\) \\left\( g\\left\(y e^{i \\theta} \\right\) - g\\le