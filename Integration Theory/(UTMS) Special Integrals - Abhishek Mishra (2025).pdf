heta} \\right\)}{2} \\, d \\theta \\\\ & = \\frac{1}{\\pi} \\int_{0}^{\\pi} a_n \\, d \\theta +\ \\frac{1}{\\pi} \\sum_{j = -\\infty, j \\neq n}^{\\infty} \\int_{0}^{\\pi} a_j \\cos \(j - n\) \\theta \\, d \\theta \\\\ & = a_n + \\frac{1}{\\pi} \\sum_{j = -\\infty, j \\neq n}^{\\infty} \\left. \\frac{a_j \\sin \(j - n\) \\theta}{j - n} \\right|_0^{\\\pi} \\\\ & = a_n. \\end{aligned}\\eUnALT{} )/Border[0 0 0]/K 41/P 15207 0 R/Pg 314 0 R/S/P/Type/StructElem>>endobj15248 0 obj<</K 43/P 15207 0 R/Pg 314 0 R/S/P/Type/StructElem>>endobj15249 0 obj<</K[44 16235 0 R 46 16236 0 R 49 16237 0 R 51 16238 0 R 54 16239 0 R 57 16240 0 R 60 16241 0 R 63 16242 0 R 66]/P 15207 0 R/Pg 314 0 R/S/P/Type/StructElem>>endobj15250 0 obj<</ActualText(\\bUnALT{} \\frac{f^{\(n\)}\(0\)}{n!} = \\frac{1}{\\pi} \\int_0^{\\pi} \\frac{e^{-i n \\theta}f\(e^{i \\theta}\) + e^{i n \\theta}f\(e^{-i \\theta}\)}{2} \\, d \\theta.\\eUnALT{} )/Border[0 0 0]/K 67/P 15207 0 R/Pg 314 0 R/S/P/Type/StructElem>>endobj15251 0 obj<</K[70 16232 0 R 72 16233 0 R 75]/P 15207 0 R/Pg 314 0 R/S/P/Type/StructElem>>endobj15252 0 obj<</K[76 16222 0 R 78 16223 0 R 81 16224 0 R 83 16225 0 R 86 16226 0 R 89 16227 0 R 92 16228 0 R 95 16229 0 R 98]/P 15207 0 R/Pg 314 0 R/S/P/Type/StructElem>>endobj15253 0 obj<</ActualText(\\bUnALT{} \\label{eq:4.10} a_n + a_{-n} = \\frac{2}{\\pi} \\int_0^{\\pi} \\frac{f \\left\(e^{i \\theta}\\right\) + f \\left\(e^{-i \\theta}\\right\)}{2} \\cos n \\theta \\, d \\theta.\\eUnALT{} )/Border[0 0 0]/K 99/P 15207 0 R/Pg 314 0 R/S/P/Type/StructElem>>endobj15254 0 obj<</K[1 16216 0 R 3 16217 0 R 6 16218 0 R 9 16219 0 R 12 16220 0 R 15]/P 15207 0 R/Pg 317 0 R/S/P/Type/StructElem>>endobj15255 0 obj<</ActualText(\\bUnALT{} \\begin{aligned} & \\frac{2}{\\pi} \\int_{0}^{\\pi} \\frac{f \\left\( e^{i \\theta} \\right\) + f \\left\( e^{-i \\theta} \\right\)}{2} \\cos n \\theta \\, d \\theta = \\frac{2}{\\pi} \\int_0^{\\pi} \\left\( \\sum_{j = -\\infty}^{\\infty} a_j \\\cos j \\theta 