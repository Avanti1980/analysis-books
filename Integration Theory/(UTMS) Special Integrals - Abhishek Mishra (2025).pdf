)^m}{2} \\right. \\nonumber\\\\ && \\qquad \\left. + \\frac{2^m e^{in \\\theta} \\sin^m \\displaystyle \\frac{\\theta}{2} \\left\( \\sin \\frac{\\theta}{2} + i \\cos \\frac{\\theta}{2} \\right\)^m }{2} \\right\) \\, d \\theta \\nonumber\\\\ && = \\int_0^\\pi \\frac{ e^{-in \\theta} e^{-i\(\\pi - \\theta\)m / 2} \\sin^m \\displ\aystyle \\frac{\\theta}{2} + e^{in \\theta} e^{i\(\\pi - \\theta\)m / 2} \\sin^m \\frac{\\theta}{2}}{2} \\, d \\theta \\nonumber\\\\ && = \\int_0^\\pi \\frac{e^{-i\(\(2n - m\) \\theta + m \\pi\) / 2} + e^{i \(\(2n - m\) \\theta + m \\pi\) / 2}}{2} \\sin^m\ \\frac{\\theta}{2} \\, d \\theta \\nonumber\\\\ && = \\int_0^\\pi \\cos \\frac{\(2n - m\) \\theta + m \\pi}{2} \\sin^m \\frac{\\theta}{2} \\, d \\theta. \\eALT{} )/Border[0 0 0]/K 30/P 11088 0 R/Pg 909 0 R/S/P/Type/StructElem>>endobj11091 0 obj<</K 0/P 11088 0 R/Pg 912 0 R/S/P/Type/StructElem>>endobj11092 0 obj<</K 3/P 11088 0 R/Pg 912 0 R/S/P/Type/StructElem>>endobj11093 0 obj<</K 11096 0 R/P 11089 0 R/S/Reference/Type/StructElem>>endobj11094 0 obj<</ActualText(f\(z\) = \(1 - z\)^m)/K 24/P 11089 0 R/Pg 909 0 R/S/Span/Type/StructElem>>endobj11095 0 obj<</ActualText(\(m, n\) \\in \(\\mathbb{N} - 1\) \\times [0 \\ldotp \\ldotp m])/K 27/P 11089 0 R/Pg 909 0 R/S/Span/Type/StructElem>>endobj11096 0 obj<</Alt(Please refer Formula 10.8 your for more information)/K[<</Obj 4593 0 R/Type/OBJR>>22]/P 11093 0 R/Pg 909 0 R/S/Link/Type/StructElem>>endobj11097 0 obj<</Alt(Footnote )/K 5/P 9615 0 R/Pg 909 0 R/S/Lbl/Type/StructElem>>endobj11098 0 obj<</K[11099 0 R 11100 0 R]/P 9615 0 R/S/LBody/Type/StructElem>>endobj11099 0 obj<</K[6 11101 0 R 8 11102 0 R 11 11103 0 R 14 11104 0 R 16]/P 11098 0 R/Pg 909 0 R/S/P/Type/StructElem>>endobj11100 0 obj<</ActualText(\\bUnALT{} \\frac{\\pi}{2^m} a_n = 0 = \\int_0^\\pi \\cos \\frac{\(2n - m\) \\theta}{2} \\cos^m \\frac{\\theta}{2} \\, d \\theta.\\eUnALT{} )/Border[0 0 0]/K 17/P 11098 0 R/Pg 909 0 R/S/P/Type/StructElem>>endobj11101 0 