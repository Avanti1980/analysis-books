m_{k = 0}^{j - 1} \\left\( \(-1\)^{2j - k} \\binom{2j}{k} e^{ik \\theta} e^{-i\(2j - k\) \\theta} + \(-1\)^{k}\\binom{2j}{2j - k} e^{i\(2j - k\) \\\theta} e^{-ik \\theta} \\right\) \\nonumber\\\\ && \\quad + \\sum_{j = 0}^{\\infty} a_{2j + 1}x^{2j + 1} \\sum_{k = 0}^{j} \\left\( \(-1\)^{2j + 1 - k} \\binom{2j + 1}{k} e^{ik \\theta} e^{-i\(2j + 1 - k\) \\theta} \\right. \\nonumber \\\\ && \\left. \\qu\ad + \(-1\)^{k} \\binom{2j + 1}{2j + 1 - k} e^{i\(2j + 1 - k\) \\theta} e^{-ik \\theta} \\right\) \\nonumber\\\\ && = \\sum_{j = 0}^{\\infty} \(-1\)^j \\binom{2j}{j} a_{2j}x^{2j} + \\sum_{j = 0}^{\\infty} a_{2j}x^{2j} \\sum_{k = 0}^{j - 1} \(-1\)^k \\bino\m{2j}{k} \\left\( e^{-i\(2j - 2k\) \\theta} + e^{i\(2j - 2k\) \\theta} \\right\)\\nonumber \\\\ && \\quad + \\sum_{j = 0}^{\\infty} a_{2j + 1}x^{2j + 1} \\sum_{k = 0}^{j} \(-1\)^k \\binom{2j + 1}{k} \\left\( -e^{-i\(2j - 2k + 1\) \\theta} + e^{i\(2j - 2k \+ 1\) \\theta} \\right\) \\nonumber\\\\ && = \\sum_{j = 0}^{\\infty} \(-1\)^j \\binom{2j}{j} a_{2j}x^{2j} + 2 \\sum_{j = 0}^{\\infty} a_{2j}x^{2j} \\sum_{k = 0}^{j - 1} \(-1\)^k \\binom{2j}{k} \\cos \(2j - 2k\) \\theta \\nonumber\\\\ && \\quad + 2i \\sum_\{j = 0}^{\\infty} a_{2j + 1}x^{2j + 1} \\sum_{k = 0}^{j} \(-1\)^k \\binom{2j + 1}{k} \\sin \(2j - 2k + 1\) \\theta. \\eALT{} )/Border[0 0 0]/K 2/P 15207 0 R/Pg 341 0 R/S/P/Type/StructElem>>endobj15311 0 obj<</K 5/P 15207 0 R/Pg 341 0 R/S/P/Type/StructElem>>endobj15312 0 obj<</K[6 16095 0 R 9 16096 0 R 12 16097 0 R 14 16098 0 R 17 16099 0 R 20 16100 0 R 23 16101 0 R 26 16102 0 R 28]/P 15207 0 R/Pg 341 0 R/S/P/Type/StructElem>>endobj15313 0 obj<</ActualText(\\bUnALT{} \\begin{aligned} \\frac{1}{\\pi} & \\int_0^{\\pi} f\\left\( 2ix \\sin \\theta \\right\) \\, d \\theta = \\frac{1}{\\pi} \\int_0^{\\pi} \\left\( \\sum_{j = 0}^{\\infty}\(-1\)^j\\binom{2j}{j} a_{2j}x^{2j} \\right\) \\, d \\theta \\\\ & \\quad + \\\frac{1}{\\pi} \\int_0^{\\pi} \\left\( 2 \\sum_{j = 0}^{\\infty} a_{2j}x^{2j} \\sum_{k = 0}^{j - 