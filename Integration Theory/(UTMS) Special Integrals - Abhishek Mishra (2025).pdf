\\ & = \(n + 1\) \\sum_{j = \\max {\\, 0, -\(n + 1\) \\,}}^{\\infty} \\frac{z^j}{j! \(n + 1 + j\)!} + \\sum_{j = \\max {\\, 0, -\(n + 2\) \\,}}^{\\infty} \\frac{z^{j + 1}}{j! \(n + 2 + j\)!} \\\\ & = \(n + 1\) \\sum_{j = \\max {\\, 0, -\(n + 1\) \\\,}}^{\\infty} \\frac{z^j}{j! \(n + 1 + j\)!} + \\sum_{j = \\max {\\, 1, -\(n + 1\) \\,}}^{\\infty} \\frac{z^j}{\(j - 1\)! \(n + 1 + j\)!} \\\\ & = \\frac{[n \\geq 0]\(n + 1\)}{0! \(n + 1\)!} + \\sum_{j = \\max {\\, 1, -\(n + 1\) \\,}}^{\\infty} \\left\( \\\frac{n + 1}{j! \(n + 1 + j\)!} + \\frac{1}{\(j - 1\)! \(n + 1 + j\)!} \\right\) z^j \\\\ & = \\frac{[n \\geq 0]}{0! n!} + \\sum_{j = \\max {\\, 1, -\(n + 1\) \\,}}^{\\infty} \\left\( \\frac{n + 1}{j} + 1 \\right\) \\frac{z^j}{\(j - 1\)! \(n + 1 + j\)!} \\\\\ & = \\frac{[n \\geq 0]}{0! n!} + \\sum_{j = \\max {\\, 1, -n \\,}}^{\\infty} \\frac{z^j}{j! \(n + j\)!} \\\\ & = \\sum_{j = \\max {\\, 0, -n \\,}}^{\\infty} \\frac{z^j}{j! \(n + j\)!} \\\\ & = e\(z, n\). \\end{aligned}\\eUnALT{} )/Border[0 0 0]/K 18/P 13111 0 R/Pg 629 0 R/S/P/Type/StructElem>>endobj13128 0 obj<</K 20/P 13111 0 R/Pg 629 0 R/S/P/Type/StructElem>>endobj13129 0 obj<</K[21 13503 0 R 24 13504 0 R 27]/P 13111 0 R/Pg 629 0 R/S/P/Type/StructElem>>endobj13130 0 obj<</ActualText(\\bALT{}\\label{eq:7.2} \\sin\(z, n\) = \(n + 1\) \\sin\(z, n + 1\) + z \\cos\(z, n + 2\).\\eALT{} )/Border[0 0 0]/K 28/P 13111 0 R/Pg 629 0 R/S/P/Type/StructElem>>endobj13131 0 obj<</K 31/P 13111 0 R/Pg 629 0 R/S/P/Type/StructElem>>endobj13132 0 obj<</K[33 13499 0 R 35 13500 0 R 37]/P 13111 0 R/Pg 629 0 R/S/P/Type/StructElem>>endobj13133 0 obj<</ActualText(\\bUnALT{}\\bUnALT{} && \(n + 1\) \\sin\(z, n + 1\) + z \\cos\(z, n + 2\) \\\\ && = \(n + 1\) \\sum_{j = \\max {\\, 0, \\lfloor -\(n + 1\) / 2 \\rfloor \\,}}^{\\infty} \(-1\)^j \\frac{z^{2j + 1}}{\(2j + 1\)! \(n + 1 + 2j + 1\)!} \\\\ && \\quad + z \\sum_{\j = \\max {\\, 0, \\lceil -\(n + 2\) / 2 \\rceil \\,}}^{\\infty} \(-1\)^j \\frac{z^{2j}}{\(2j\)! \(n + 2 + 2j\)!} \\\\ && = \(n + 1\) \\sum_{j = \\max {\\, 0, \\lfloor -\(n + 1\) / 2 \\rfloor \\,}}^{\\infty} \(-1\)^j \\frac{z^{2j + 1}}{\(2j + 1\)! \(n + 1\ + 2j + 1\)!} \\\\ && \\quad + \\sum_{j = \\max {\\, 0, \\lceil -\(n + 2\) / 2 \\rceil \\,}}^{\\infty} \(-1\)^j \\frac{z^{2j + 1}}{\(2j\)! \(n + 2 + 2j\)!}\\eUnALT{} )/Border[0 0 0]/K 38/P 13111 0 R/Pg 629 0 R/S/P/Type/StructElem>>endobj13134 0 obj<</ActualText(\\bUnALT{}\\bUnALT{} && \(n + 1\) \\sin\(z, n + 1\) + z \\cos\(z, n + 2\) \\\\ && = \(n + 1\) \\sum_{j = \\max {\\, 0, \\lfloor -\(n + 1\) / 2 \\rfloor \\,}}^{\\infty} \(-1\)^j \\frac{z^{2j + 1}}{\(2j + 1\)! \(n + 1 + 2j + 1\)!} \\\\ && \\quad + z \\sum_{\j = \\max {\\, 0, \\lceil -\(n + 2\) / 2 \\rceil \\,}}^{\\infty} \(-1\)^j \\frac{z^{2j}}{\(2j\)! \(n + 2 + 2j\)!} \\\\ && = \(n + 1\) \\sum_{j = \\max {\\, 0, \\lfloor -\(n + 1\) / 2 \\rfloor \\,}}^{\\infty} \(-1\)^j \\frac{z^{2j + 1}}{\(2j + 1\)! \(n + 1\ + 2j + 1\)!} \\\\ && \\quad + \\sum_{j = \\max {\\, 0, \\lceil -\(n + 2\) / 2 \\rceil \\,}}^{\\infty} \(-1\)^j \\frac{z^{2j + 1}}{\(2j\)! \(n + 2 + 2j\)!}\\eUnALT{} )/Border[0 0 0]/K 39/P 13111 0 R/Pg 629 0 R/S/P/Type/StructElem>>endobj13135 0 obj<</K 0/P 13111 0 R/Pg 632 0 R/S/P/Type/StructElem>>endobj13136 0 obj<</ActualText(\\bUnALT{} \\begin{aligned} & = \\sum_{j = \\max {\\, 0, \\lfloor -\(n + 1\) / 2 \\rfloor \\,}}^{\\infty} \(-1\)^j \\left\( \\frac{n + 1}{\(2j + 1\)! \(n + 1 + 2j + 1\)!} \\right. \\\\ & \\left. \\quad \\quad + \\frac{1}{\(2j\)! \(n + 2 + 2j\)!} \\right\)\ z^{2j + 1} \\\\ \\pg{\\noalign{\\vskip6pt}} & = \\sum_{j = \\max {\\, 0, \\lfloor -\(n + 1\) / 2 \\rfloor \\,}}^{\\infty} \(-1\)^j \\left\( \\frac{n + 1}{2j + 1} + 1 \\right\) \\frac{z^{2j + 1}}{\(2j\)! \(n + 2 + 2j\)!} \\\\ \\pg{\\noalign{\\vskip6pt}} &\ = \\sum_{j = \\max {\\, 0, \\lfloor -\(n + 1\) / 2 \\rfloor \\,}}^{j = \\max {\\, 0, \\lfloor -\(n + 1\) / 2 \\rfloor \\,}} \(-1\)^j \\left\( \\frac{n + 2j + 2}{2j + 1} \\right\) \\frac{z^{2j + 1}}{\(2j\)! \(n + 2 + 2j\)