in \\theta} + e^{-in \\theta} \\right\) \\pm\ \\sqrt{\\left\( e^{in \\theta} + e^{-in \\theta} \\right\)^2 - 4}}{2} \\\\ & = \\frac{\\left\( e^{in \\theta} + e^{-in \\theta} \\right\) \\pm \\left\( e^{in \\theta} - e^{-in \\theta} \\right\)}{2} \\\\ & = e^{\\pm i\(n \\theta + 2j \\pi\)}, \\quad j \\\in [0 \\ldotp \\ldotp n - 1] \\\\ \\implies & x = e^{\\pm i \(\\theta + 2j \\pi / n\)}, \\quad j \\in [0 \\ldotp \\ldotp n - 1]. \\end{aligned}\\eALT{} )/Border[0 0 0]/K 37/P 18178 0 R/Pg 197 0 R/S/P/Type/StructElem>>endobj18285 0 obj<</K 40/P 18178 0 R/Pg 197 0 R/S/P/Type/StructElem>>endobj18286 0 obj<</K[41 18399 0 R 43 18400 0 R 46]/P 18178 0 R/Pg 197 0 R/S/P/Type/StructElem>>endobj18287 0 obj<</ActualText(\\bUnALT{} \\begin{aligned} x^{2n} - 2 x^n \\cos n \\theta + 1 & = \\prod_{j = 0}^{n - 1} \\left\( x - e^{i \(\\theta + 2j \\pi / n\)} \\right\) \\left\( x - e^{-i \(\\theta + 2j \\pi / n\)} \\right\) \\\\ & = \\prod_{j = 0}^{n - 1} \\left\( x^2 - x \\lef\t\( e^{i \(\\theta + 2j \\pi / n\)} + e^{-i \(\\theta + 2j \\pi / n\)} \\right\) + 1 \\right\) \\\\ & = \\prod_{j = 0}^{n - 1} \\left\( x^2 - 2x \\cos \\left\( \\theta + \\frac{2j \\pi}{n} \\right\) + 1 \\right\). \\end{aligned}\\eUnALT{} )/Border[0 0 0]/K 2/P 18178 0 R/Pg 200 0 R/S/P/Type/StructElem>>endobj18288 0 obj<</K 4/P 18178 0 R/Pg 200 0 R/S/P/Type/StructElem>>endobj18289 0 obj<</K[5 18393 0 R 7 18394 0 R 9 18395 0 R 12 18396 0 R 15]/P 18178 0 R/Pg 200 0 R/S/P/Type/StructElem>>endobj18290 0 obj<</ActualText(\\bALT{}\\label{eq:2.22} \\begin{aligned} \\sin \\theta & = \\theta \\prod_{j = 1}^\\infty \\left\( 1 - \\frac{\\theta^2}{j^2 \\pi^2} \\right\) \\\\ & = \\theta \\left\( 1 - \\frac{\\theta^2}{\\pi^2} \\right\) \\left\( 1 - \\frac{\\theta^2}{2^2 \\pi^2} \\\right\) \\left\( 1 - \\frac{\\theta^2}{3^2 \\pi^2} \\right\) \\hdots \\end{aligned}\\eALT{} )/Border[0 0 0]/K 16/P 18178 0 R/Pg 200 0 R/S/P/Type/StructElem>>endobj18291 0 obj<</K 19/P 18178 0 R/Pg 200 0 R/S/P/Type/StructElem>>e