umber\\\\ & =& \\frac{\\pi}{2} \\left\( x^n + y^n \\right\) \\sum_{j = 0}^\\i\nfty \\binom{n + 2j}{j} \\frac{\(xy\)^j}{\(n + 2j\)!} \\nonumber\\\\ & =& \\frac{\\pi}{2} \\left\( x^n + y^n \\right\) \\sum_{j = 0}^\\infty \\frac{\(xy\)^j}{j! \(n + j\)!} \\nonumber\\\\ & =& \\frac{\\pi}{2} \\left\( x^n + y^n \\right\) e\(xy, n\) \\nonu\mber\\\\ & =& \\int_0^\\pi \\frac{e^{x e^{i \\theta} + y e^{-i \\theta}} + e^{x e^{-i \\theta} + y e^{i \\theta}}}{2} \\cos n \\theta \\, d \\theta \\nonumber\\\\ & =& \\int_0^\\pi \\frac{e^{\(x + y\) \\cos \\theta + i\(x - y\) \\sin \\theta} + e^{\(x + y\\) \\cos \\theta - i\(x - y\) \\sin \\theta}}{2} \\cos n \\theta \\, d \\theta \\nonumber\\\\ & =& \\int_0^\\pi e^{\(x + y\) \\cos \\theta} \\frac{e^{i\(x - y\) \\sin \\theta} + e^{- i\(x - y\) \\sin \\theta}}{2} \\cos n \\theta \\, d \\theta \\nonumber\\\\\ & =& \\int_0^\\pi e^{\(x + y\) \\cos \\theta} \\cos\(\(x - y\) \\sin \\theta\) \\cos n \\theta \\, d \\theta.\\eALT{} )/Border[0 0 0]/K 16/P 9124 0 R/Pg 1088 0 R/S/P/Type/StructElem>>endobj9127 0 obj<</ActualText(\\bALT{}\\bALT{}\\label{eq:11a.8} \\frac{\\pi}{2} T_n\(x, y\) & =& \\frac{\\pi}{2} \\left\( x^n + y^n \\right\) \\sum_{j = 0}^\\infty \\binom{n + 2j}{j} a_{n + 2j} \(xy\)^j \\nonumber\\\\ & =& \\frac{\\pi}{2} \\left\( x^n + y^n \\right\) \\sum_{j = 0}^\\i\nfty \\binom{n + 2j}{j} \\frac{\(xy\)^j}{\(n + 2j\)!} \\nonumber\\\\ & =& \\frac{\\pi}{2} \\left\( x^n + y^n \\right\) \\sum_{j = 0}^\\infty \\frac{\(xy\)^j}{j! \(n + j\)!} \\nonumber\\\\ & =& \\frac{\\pi}{2} \\left\( x^n + y^n \\right\) e\(xy, n\) \\nonu\mber\\\\ & =& \\int_0^\\pi \\frac{e^{x e^{i \\theta} + y e^{-i \\theta}} + e^{x e^{-i \\theta} + y e^{i \\theta}}}{2} \\cos n \\theta \\, d \\theta \\nonumber\\\\ & =& \\int_0^\\pi \\frac{e^{\(x + y\) \\cos \\theta + i\(x - y\) \\sin \\theta} + e^{\(x + y\\) \\cos \\theta - i\(x - y\) \\sin \\theta}}{2} \\cos n \\theta \\, d \\theta \\nonumber\\\\ & =& \\int_0^\\pi e^{\(x + y\) \\cos \\theta} \\frac{e^{i\(x - y\) \\sin \\theta} + e^{- i\(x - y\) \\sin \\theta}}{2} \\cos n \\theta \\, d \\theta \\nonumber\\\\\ & =& \\int_0^\\pi e^{\(x + y\) \\cos \\theta} \\cos\(\(x - y\) \\sin \\theta\) \\cos n \\theta \\, d \\theta.\\eALT{} )/Border[0 0 0]/K 17/P 9124 0 R/Pg 1088 0 R/S/P/Type/StructElem>>endobj9128 0 obj<</K 20/P 9124 0 R/Pg 1088 0 R/S/P/Type/StructElem>>endobj9129 0 obj<</K[23 9131 0 R 26 9132 0 R 28 9133 0 R 30]/P 9124 0 R/Pg 1088 0 R/S/P/Type/StructElem>>endobj9130 0 obj<</ActualText(\\bUnALT{} \\begin{aligned} & \\int_0^{\\pi} e^{\(x + y\) \\cos \\theta} \\cos \\left\( \(x - y\) \\sin \\theta \\right\) \\cos n \\theta \\, d \\theta \\\\ & = \\int_0^{\\pi} e^{\(x + y\) \\cos \\theta} \\cos \\left\( \(x - y\) \\sin \\theta \\right\) \\\cos \(-n \\theta\) \\, d \\theta \\\\ & = \\frac{\\pi}{2} \\left\(x^{-n} + y^{-n} \\right\) e\(xy, -n\) \\\\ & = \\frac{\\pi}{2} \\left\(x^{-n} + y^{-n} \\right\) \(xy\)^n e\(xy, n\) \\\\ & = \\frac{\\pi}{2} \\left\(x^{n} + y^{n} \\right\) e\(xy, n\). \\e\nd{aligned}\\eUnALT{} )/Border[0 0 0]/K 31/P 9124 0 R/Pg 1088 0 R/S/P/Type/StructElem>>endobj9131 0 obj<</ActualText(n \\in -\\mathbb{N})/K 24/P 9129 0 R/Pg 1088 0 R/S/Span/Type/StructElem>>endobj9132 0 obj<</K 9135 0 R/P 9129 0 R/S/Reference/Type/StructElem>>endobj9133 0 obj<</K 9134 0 R/P 9129 0 R/S/Reference/Type/StructElem>>endobj9134 0 obj<</Alt(Please refer Formula 11.8 your for more information)/K[<</Obj 5493 0 R/Type/OBJR>>29]/P 9133 0 R/Pg 1088 0 R/S/Link/Type/StructElem>>endobj9135 0 obj<</Alt(Please refer Formula 5.12 your for more information)/K[<</Obj 5495 0 R/Type/OBJR>>27]/P 9132 0 R/Pg 1088 0 R/S/Link/Type/StructElem>>endobj9136 0 obj<</K 9143 0 R/P 9125 0 R/S/Reference/Type/StructElem>>endobj9137 0 obj<</ActualText(f\(z\) = e^z)/K 6/P 9125 0 R/Pg 1088 0 R/S/Span/Type/StructElem>>endobj9138 0 obj<</ActualText(n \\in \\mathbb{N} - 1)/K 9/P 9125 0 R/Pg 1088 0 R/S/Span/Type/StructElem>>endobj9139 0 obj<</K 9142 0 R/P 9125 0 R/S/Reference