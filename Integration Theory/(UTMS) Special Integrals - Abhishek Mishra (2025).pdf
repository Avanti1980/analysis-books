heta + 2x^2 + 1} \\\\ & = \\frac{x \\sin \\theta}{x^2 + 2x \\cos \\theta + 1} + \\frac{4 x^2 \\sin \\theta \\cos \\theta}{\\left\( x^2 - 2x \\cos \\theta + 1 \\right\) \\left\( x^2 + 2x \\cos \\\theta + 1 \\right\)} \\\\ & = \\frac{x \\sin \\theta}{x^2 + 2x \\cos \\theta + 1} + \\frac{x \\sin \\theta}{x^2 - 2x \\cos \\theta + 1} - \\frac{x \\sin \\theta}{x^2 + 2x \\cos \\theta + 1} \\\\ & = \\frac{x \\sin \\theta}{x^2 - 2x \\cos \\theta + 1}. \\e\nd{aligned}\\eUnALT{} )/Border[0 0 0]/K 12/P 12389 0 R/Pg 780 0 R/S/P/Type/StructElem>>endobj12399 0 obj<</K 12100 0 R/P 12397 0 R/S/Reference/Type/StructElem>>endobj12400 0 obj<</ActualText(n - 1)/K 9/P 12397 0 R/Pg 780 0 R/S/Span/Type/StructElem>>endobj12401 0 obj<</Alt(Footnote )/K 5/P 12242 0 R/Pg 774 0 R/S/Lbl/Type/StructElem>>endobj12402 0 obj<</K[12403 0 R 12404 0 R 12405 0 R 12406 0 R 12407 0 R 12408 0 R 12409 0 R 12410 0 R 12411 0 R 12412 0 R]/P 12242 0 R/S/LBody/Type/StructElem>>endobj12403 0 obj<</K 6/P 12402 0 R/Pg 774 0 R/S/P/Type/StructElem>>endobj12404 0 obj<</ActualText(\\bUnALT{} f\(x, \\theta, n\) = \\sum_{j = 0}^{n-1} \\frac{2^j \\left\( x^{2^j} \\cos 2^j \\theta + 1 \\right\)}{x^{2^{j + 1}} + 2 x^{2^j} \\cos 2^j \\theta + 1} + \\frac{2^n \\left\( x^{2^n} \\cos 2^n \\theta - 1 \\right\)}{x^{2^{n + 1}} - 2 x^{2^n} \\co\s 2^n \\theta + 1}.\\eUnALT{} )/Border[0 0 0]/K 7/P 12402 0 R/Pg 774 0 R/S/P/Type/StructElem>>endobj12405 0 obj<</K 9/P 12402 0 R/Pg 774 0 R/S/P/Type/StructElem>>endobj12406 0 obj<</ActualText(\\bALT{}\\bALT{}\\label{eq:18.7} f\(x, \\theta, n\) & =& \\sum_{j = 0}^{n-1} \\frac{2^j \\left\( x^{2^j} \\cos 2^j \\theta + 1 \\right\)}{x^{2^{j + 1}} + 2 x^{2^j} \\cos 2^j \\theta + 1} + \\frac{2^n \\left\( x^{2^n} \\cos 2^n \\theta - 1 \\right\)}{x^{2^\{n + 1}} - 2 x^{2^n} \\cos 2^n \\theta + 1} \\nonumber\\\\ & =& \\sum_{j = 0}^{n-2} \\frac{2^j \\left\( x^{2^j} \\cos 2^j \\theta + 1 \\right\)}{x^{2^{j + 1}} + 2 x^{2^j} \\cos 2^j \\theta + 1} + \\frac{2^{n - 1} \\left\( x^{2^{n - 1}} \\cos 2^{n - 1} \\t\heta + 1 \\right\)}{x^{2^{n}} + 2 x^{2^{n - 1}} \\cos 2^{n - 1} \\theta + 1} \\nonumber\\\\ && \\quad + \\frac{2^n \\left\( x^{2^n} \\cos 2^n \\theta - 1 \\right\)}{x^{2^{n + 1}} - 2 x^{2^n} \\cos 2^n \\theta + 1} \\nonumber\\\\ & =& \\sum_{j = 0}^{n-2} \\\frac{2^j \\left\( x^{2^j} \\cos 2^j \\theta + 1 \\right\)}{x^{2^{j + 1}} + 2 x^{2^j} \\cos 2^j \\theta + 1} + \\frac{2^{n - 1} \\left\( x^{2^{n - 1}} \\cos 2^{n - 1} \\theta + 1 \\right\)}{x^{2^{n}} + 2 x^{2^{n - 1}} \\cos 2^{n - 1} \\theta + 1} \\nonumbe\r\\\\ && \\quad + \\frac{2^n \\left\( 2 x^{2^n} \\cos^2 2^{n - 1} \\theta - x^{2^n} - 1 \\right\)}{x^{2^{n + 1}} - 4 x^{2^n} \\cos^2 2^{n - 1} \\theta + 2 x^{2^n} + 1} \\nonumber\\\\ & =& \\sum_{j = 0}^{n-2} \\frac{2^j \\left\( x^{2^j} \\cos 2^j \\theta +\ 1 \\right\)}{x^{2^{j + 1}} + 2 x^{2^j} \\cos 2^j \\theta + 1} + \\frac{2^{n - 1} \\left\( x^{2^{n - 1}} \\cos 2^{n - 1} \\theta + 1 \\right\)}{x^{2^{n}} + 2 x^{2^{n - 1}} \\cos 2^{n - 1} \\theta + 1} \\nonumber\\\\ && \\quad + \\frac{2^n \\left\( 2 x^{2^\n} \\cos^2 2^{n - 1} \\theta - x^{2^n} - 1 \\right\)}{\\left\( x^{2^{n}} - 2 x^{2^{n - 1}} \\cos 2^{n - 1} \\theta + 1 \\right\) \\left\( x^{2^{n}} + 2 x^{2^{n - 1}} \\cos 2^{n - 1} \\theta + 1 \\right\)} \\nonumber\\\\ & =& \\sum_{j = 0}^{n-2} \\frac{2^j\ \\left\( x^{2^j} \\cos 2^j \\theta + 1 \\right\)}{x^{2^{j + 1}} + 2 x^{2^j} \\cos 2^j \\theta + 1} + \\frac{2^{n - 1} \\left\( x^{2^{n - 1}} \\cos 2^{n - 1} \\theta + 1 \\right\)}{x^{2^{n}} + 2 x^{2^{n - 1}} \\cos 2^{n - 1} \\theta + 1} \\nonumber\\\\ &&\ \\quad + \\frac{2^{n - 1} \\left\( x^{2^{n - 1}} \\cos 2^{n - 1} \\theta - 1 \\right\)}{x^{2^{n}} - 2 x^{2^{n - 1}} \\cos 2^{n - 1} \\theta + 1} - \\frac{2^{n - 1} \\left\( x^{2^{n - 1}} \\cos 2^{n - 1} \\theta + 1 \\right\)}{x^{2^{n}} + 2 x^{2^{n - 1}} \\\cos 2^{n - 1} \\theta + 1} \\nonumber\\\\ & =& \\sum_{j = 0}^{n-2} \\frac{2^j \\left\( x^{2^j} \\cos 2^j \\theta + 1 \\right\)}{x^{2^{j + 1}} + 2 x^{2^j} \\cos 2^j \\theta + 1} + \\frac{2^{n - 1} \\left\( x^{2^{n - 1}} \\cos 2^{n - 1} \\theta - 1 \\righ\t\)}{x^{2^{n}} - 2 x^{2^{n - 1}} \\cos 2^{n - 1} \\theta + 1} \\nonumber\\\\ & =& f\(x, \\theta, n - 1\).\\eALT{} )/Border[0 0 0]/K 10/P 12402 0 R/Pg 774 0 R/S/P/Type/StructElem>>endobj12407 0 obj<</ActualText(\\bALT{}\\bALT{}\\label{eq:18.7} f\(x, \\theta, n\) & =& \\sum_{j = 0}^{n-1} \\frac{2^j \\left\( x^{2^j} \\cos 2^j \\theta + 1 \\right\)}{x^{2^{j + 1}} + 2 x^{2^j} \\cos 2^j \\theta + 1} + \\frac{2^n \\left\( x^{2^n} \\cos 2^n \\theta - 1 \\right\)}{x^{2^\{n + 1}} - 2 x^{2^n} \\cos 2^n \\theta + 1} \\nonumber\\\\ & =& \\sum_{j = 0}^{n-2} \\frac{2^j \\left\( x^{2^j} \\cos 2^j \\theta + 1 \\right\)}{x^{2^{j + 1}} + 2 x^{2^j} \\cos 2^j \\theta + 1} + \\frac{2^{n - 1} \\left\( x^{2^{n - 1}} \\cos 2^{n - 1} \\t\heta + 1 \\right\)}{x^{2^{n}} + 2 x^{2^{n - 1}} \\cos 2^{n - 1} \\theta + 1} \\nonumber\\\\ && \\quad + \\frac{2^n \\left\( x^{2^n} \\cos 2^n \\theta - 1 \\right\)}{x^{2^{n + 1}} - 2 x^{2^n} \\cos 2^n \\theta + 1} \\nonumber\\\\ & =& \\sum_{j = 0}^{n-2} \\\frac{2^j \\left\( x^{2^j} \\cos 2^j \\theta + 1 \\right\)}{x^{2^{j + 1}} + 2 x^{2^j} \\cos 2^j \\theta + 1} + \\frac{2^{n - 1} \\left\( x^{2^{n - 1}} \\cos 2^{n - 1} \\theta + 1 \\right\)}{x^{2^{n}} + 2 x^{2^{n - 1}} \\cos 2^{n - 1} \\theta + 1} \\nonumbe\r\\\\ && \\quad + \\frac{2^n \\left\( 2 x^{2^n} \\cos^2 2^{n - 1} \\theta - x^{2^n} - 1 \\right\)}{x^{2^{n + 1}} - 4 x^{2^n} \\cos^2 2^{n - 1} \\theta + 2 x^{2^n} + 1} \\nonumber\\\\ & =& \\sum_{j = 0}^{n-2} \\frac{2^j \\left\( x^{2^j} \\cos 2^j \\theta +\ 1 \\right\)}{x^{2^{j + 1}} + 2 x^{2^j} \\cos 2^j \\theta + 1} + \\frac{2^{n - 1} \\left\( x^{2^{n - 1}} \\cos 2^{n - 1} \\theta + 1 \\right\)}{x^{2^{n}} + 2 x^{2^{n - 1}} \\cos 2^{n - 1} \\theta + 1} \\nonumber\\\\ && \\quad + \\frac{2^n \\left\( 2 x^{2^\n} \\cos^2 2^{n - 1} \\theta - x^{2^n} - 1 \\right\)}{\\left\( x^{2^{n}} - 2 x^{2^{n - 1}} \\cos 2^{n - 1} \\theta + 1 \\right\) \\left\( x^{2^{n}} + 2 x^{2^{n - 1}} \\cos 2^{n - 1} \\theta + 1 \\right\)} \\nonumber\\\\ & =& \\sum_{j = 0}^{n-2} \\frac{2^j\ \\left\( x^{2^j} \\cos 2^j \\theta + 1 \\right\)}{x^{2^{j + 1}} + 2 x^{2^j} \\cos 2^j \\theta + 1} + \\frac{2^{n - 1} \\left\( x^{2^{n - 1}} \\cos 2^{n - 1} \\theta + 1 \\right\)}{x^{2^{n}} + 2 x^{2^{n - 1}} \\cos 2^{n - 1} \\theta + 1} \\nonumber\\\\ &&\ \\quad + \\frac{2^{n - 1} \\left\( x^{2^{n - 1}} \\cos 2^{n - 1} \\theta - 1 \\right\)}{x^{2^{n}} - 2 x^{2^{n - 1}} \\cos 2^{n - 1} \\theta + 1} - \\frac{2^{n - 1} \\left\( x^{2^{n - 1}} \\cos 2^{n - 1} \\theta + 1 \\right\)}{x^{2^{n}} + 2 x^{2^{n - 1}} \\\cos 2^{n - 1} \\theta + 1} \\nonumber\\\\ & =& \\sum_{j = 0}^{n-2} \\frac{2^j \\left\( x^{2^j} \\cos 2^j \\theta + 1 \\right\)}{x^{2^{j + 1}} + 2 x^{2^j} \\cos 2^j \\theta + 1} + \\frac{2^{n - 1} \\left\( x^{2^{n - 1}} \\cos 2^{n - 1} \\theta - 1 \\righ\t\)}{x^{2^{n}} - 2 x^{2^{n - 1}} \\cos 2^{n - 1} \\theta + 1} \\nonumber\\\\ & =& f\(x, \\theta, n - 1\).\\eALT{} )/Border[0 0 0]/K 11/P 12402 0 R/Pg 774 0 R/S/P/Type/StructElem>>endobj12408 0 obj<</K 0/P 12402 0 R/Pg 777 0 R/S/P/Type/StructElem>>endobj12409 0 obj<</K 3/P 12402 0 R/Pg 777 0 R/S/P/Type/StructElem>>endobj12410 0 obj<</K[6 12413 0 R 8 12414 0 R 11]/P 12402 0 R/Pg 777 0 R/S/P/Type/StructElem>>endobj12411 0 obj<</ActualText(\\bUnALT{}\\bUnALT{} f \(x, \\theta, n\) & =& f\(x, \\theta, 1\) = \\frac{x \\cos \\theta + 1}{x^2 + 2x \\cos \\theta + 1} + \\frac{2 \\left\( x^2 \\cos 2 \\theta - 1 \\right\)}{x^4 - 2x^2 \\cos 2 \\theta + 1} \\\\ & =& \\frac{x \\cos \\theta + 1}{x^2 + 2\x \\cos \\theta + 1} + \\frac{2 \\left\( 2 x^2 \\cos^2 \\theta - x^2 - 1 \\right\)}{x^4 - 4x^2 \\cos^2 \\theta + 2x^2 + 1} \\\\ & =& \\frac{x \\cos \\theta + 1}{x^2 + 2x \\cos \\theta + 1} + \\frac{2 \\left\( 2 x^2 \\cos^2 \\theta - x^2 - 1 \\right\)}{\\l\eft\( x^2 - 2x \\cos \\theta + 1 \\right\) \\left\( x^2 + 2x \\cos \\theta + 1 \\right\)} \\\\ & =& \\frac{x \\cos \\theta + 1}{x^2 + 2x \\cos \\theta + 1} + \\frac{x \\cos \\theta - 1}{x^2 - 2x \\cos \\theta + 1} - \\frac{x \\cos \\theta + 1}{x^2 + 2x \\\cos \\theta + 1} \\\\ & =& \\frac{x \\cos \\theta - 1}{x^2 - 2x \\cos \\theta + 1}.\\eUnALT{} )/Border[0 0 0]/K 12/P 12402 0 R/Pg 777 0 R/S/P/Type/StructElem>>endobj12412 0 obj<</ActualText(\\bUnALT{}\\bUnALT{} f \(x, \\theta, n\) & =& f\(x, \\theta, 1\) = \\frac{x \\cos \\theta + 1}{x^2 + 2x \\cos \\theta + 1} + \\frac{2 \\left\( x^2 \\cos 2 \\theta - 1 \\right\)}{x^4 - 2x^2 \\cos 2 \\theta + 1} \\\\ & =& \\frac{x \\cos \\theta + 1}{x^2 + 2\x \\cos \\theta + 1} + \\frac{2 \\left\( 2 x^2 \\cos^2 \\theta - x^2 - 1 \\right\)}{x^4 - 4x^2 \\cos^2 \\theta + 2x^2 + 1} \\\\ & =& \\frac{x \\cos \\theta + 1}{x^2 + 2x \\cos \\theta + 1} + \\frac{2 \\left\( 2 x^2 \\cos^2 \\theta - x^2 - 1 \\right\)}{\\l\eft\( x^2 - 2x \\cos \\theta + 1 \\right\) \\left\( x^2 + 2x \\cos \\theta + 1 \\right\)} \\\\ & =& \\frac{x \\cos \\theta + 1}{x^2 + 2x \\cos \\theta + 1} + \\frac{x \\cos \\theta - 1}{x^2 - 2x \\cos \\theta + 1} - \\frac{x \\cos \\theta + 1}{x^2 + 2x \\\cos \\theta + 1} \\\\ & =& \\frac{x \\cos \\theta - 1}{x^2 - 2x \\cos \\theta + 1}.\\eUnALT{} )/Border[0 0 0]/K 13/P 12402 0 R/Pg 777 0 R/S/P/Type/StructElem>>endobj12413 0 obj<</K 12099 0 R/P 12410 0 R/S/Reference/Type/StructElem>>endobj12414 0 obj<</ActualText(n - 1)/K 9/P 12410 0 R/Pg 777 0 R/S/Span/Type/StructElem>>endobj12415 0 obj<</Alt(Footnote )/K 18/P 12241 0 R/Pg 771 0 R/S/Lbl/Type/StructElem>>endobj12416 0 obj<</K[12417 0 R 12418 0 R 12419 0 R 12420 0 R 12421 0 R]/P 12241 0 R/S/LBody/Type/StructElem>>endobj12417 0 obj<</K[19 12423 0 R 22 12424 0 R 25]/P 12416 0 R/Pg 771 0 R/S/P/Type/StructElem>>endobj12418 0 obj<</ActualText(\\bALT{}\\label{eq:18.6} \\frac{1}{xy - 1} = \\sum_{j = 0}^{n-1} \\frac{2^j}{x^{2^j} y^{2^j} + 1} + \\frac{2^n}{x^{2^n} y^{2^n} - 1}.\\eALT{} )/Border[0 0 0]/K 26/P 12416 0 R/Pg 771 0 R/S/P/Type/StructElem>>endobj12419 0 obj<</K 29/P 12416 0 R/Pg 771 0 R/S/P/Type/StructEle