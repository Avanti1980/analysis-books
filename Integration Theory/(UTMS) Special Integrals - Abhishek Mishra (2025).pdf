1\)} \\left\(1 + x^{1 / 2^j} \\right\)^{k + 1}} \\\\ & = \\sum\_{k = 1}^{n} \\left\( \\frac{k a_k}{n\(x - 1\)^{k}} + \\frac{k a_k}{n\(x - 1\)^{k + 1}} \\right\) \\\\ & \\quad + \\sum_{k = 1}^{n} \\sum_{j = 1}^{\\infty} \\left\( \\frac{k b_k}{n 2^{j \(n + 1\)} \\left\(1 + x^{1 / 2^j} \\right\)^{k}} - \\frac{k b_k}{n 2\^{j \(n + 1\)} \\left\(1 + x^{1 / 2^j} \\right\)^{k + 1}} \\right\) \\\\ & = \\frac{a_1}{n \(x - 1\)} + \\sum_{k = 2}^{n} \\frac{\(k - 1\) a_{k - 1} + k a_k}{n\(x - 1\)^{k}} + \\frac{a_n}{\(x - 1\)^{n + 1}} \\\\ & \\quad + \\sum_{j = 1}^{\\infty} \\frac{b\_1}{n 2^{j \(n + 1\)} \\left\(1 + x^{1 / 2^j} \\right\)} + \\sum_{k = 2}^{n} \\sum_{j = 1}^{\\infty} \\frac{k b_k - \(k - 1\) b_{k - 1}}{n 2^{j \(n + 1\)} \\left\(1 + x^{1 / 2^j} \\right\)^{k}} \\\\ & \\quad - \\sum_{j = 1}^{\\infty} \\frac{b_n}{2^{j \(n \+ 1\)} \\left\(1 + x^{1 / 2^j} \\right\)^{n + 1}}, \\end{aligned}\\eUnALT{} )/Border[0 0 0]/K 13/P 12319 0 R/Pg 795 0 R/S/P/Type/StructElem>>endobj12325 0 obj<</K[15 12326 0 R 18]/P 12319 0 R/Pg 795 0 R/S/P/Type/StructElem>>endobj12326 0 obj<</ActualText(P\(n + 1\))/K 16/P 12325 0 R/Pg 795 0 R/S/Span/Type/StructElem>>endobj12327 0 obj<</ActualText(P\(1\))/K 2/P 12323 0 R/Pg 795 0 R/S/Span/Type/StructElem>>endobj12328 0 obj<</ActualText(P\(n\))/K 5/P 12323 0 R/Pg 795 0 R/S/Span/Type/StructElem>>endobj12329 0 obj<</K 12107 0 R/P 12323 0 R/S/Reference/Type/StructElem>>endobj12330 0 obj<</ActualText(x)/K 10/P 12323 0 R/Pg 795 0 R/S/Span/Type/StructElem>>endobj12331 0 obj<</ActualText(P\(n\))/K 36/P 12320 0 R/Pg 792 0 R/S/Span/Type/StructElem>>endobj12332 0 obj<</ActualText(\\forall n \\in \\mathbb{N})/K 39/P 12320 0 R/Pg 792 0 R/S/Span/Type/StructElem>>endobj12333 0 obj<</ActualText(\\exists \(a_k\)_{k = 1}^n \\in \\mathbb{R}^n)/K 42/P 12320 0 R/Pg 792 0 R/S/Span/Type/StructElem>>endobj12334 0 obj<</ActualText(\\exists \(b_k\)_{k = 1}^n \\in \\mathbb{R}^n)/K 45/P 12320 0 R/Pg 792 0 R/S/Span/Type/StructElem>>endobj12335 