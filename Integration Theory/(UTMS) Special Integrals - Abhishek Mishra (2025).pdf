n - 1}} \\cos 2^{n - 1} \\theta + 1 \\right\) \\left\( x^{2^{n}} + 2 x^{2^{n - 1}} \\cos 2^{n - 1} \\theta + 1 \\right\)} \\nonumber\\\\ \& =& \\sum_{j = 0}^{n-2} \\frac{2^j x^{2^j} \\sin 2^j \\theta}{x^{2^{j + 1}} + 2 x^{2^j} \\cos 2^j \\theta + 1} + \\frac{2^{n - 1} x^{2^{n - 1}} \\sin 2^{n - 1} \\theta}{x^{2^{n}} + 2 x^{2^{n - 1}} \\cos 2^{n - 1} \\theta + 1} \\nonumber\\\\ && \\quad + \\\frac{2^{n - 1} x^{2^{n - 1}} \\sin 2^{n - 1} \\theta}{x^{2^{n}} - 2 x^{2^{n - 1}} \\cos 2^{n - 1} \\theta + 1} - \\frac{2^{n - 1} x^{2^{n - 1}} \\sin 2^{n - 1} \\theta}{x^{2^{n}} + 2 x^{2^{n - 1}} \\cos 2^{n - 1} \\theta + 1} \\nonumber\\\\ & =& \\sum_{j \= 0}^{n-2} \\frac{2^j x^{2^j} \\sin 2^j \\theta}{x^{2^{j + 1}} + 2 x^{2^j} \\cos 2^j \\theta + 1} + \\frac{2^{n - 1} x^{2^{n - 1}} \\sin 2^{n - 1} \\theta}{x^{2^{n}} - 2 x^{2^{n - 1}} \\cos 2^{n - 1} \\theta + 1} \\nonumber\\\\ & =& f\(x, \\theta, n - 1\)\.\\eALT{} )/Border[0 0 0]/K 23/P 12389 0 R/Pg 777 0 R/S/P/Type/StructElem>>endobj12394 0 obj<</ActualText(\\bALT{}\\bALT{}\\label{eq:18.8} f\(x, \\theta, n\) & =& \\sum_{j = 0}^{n-1} \\frac{2^j x^{2^j} \\sin 2^j \\theta}{x^{2^{j + 1}} + 2 x^{2^j} \\cos 2^j \\theta + 1} + \\frac{2^n x^{2^n} \\sin 2^n \\theta}{x^{2^{n + 1}} - 2 x^{2^n} \\cos 2^n \\theta + 1} \\\nonumber\\\\ & =& \\sum_{j = 0}^{n-2} \\frac{2^j x^{2^j} \\sin 2^j \\theta}{x^{2^{j + 1}} + 2 x^{2^j} \\cos 2^j \\theta + 1} + \\frac{2^{n - 1} x^{2^{n - 1}} \\sin 2^{n - 1} \\theta}{x^{2^{n}} + 2 x^{2^{n - 1}} \\cos 2^{n - 1} \\theta + 1} \\nonumber\\\\ \&& \\quad + \\frac{2^n x^{2^n} \\sin 2^n \\theta}{x^{2^{n + 1}} - 2 x^{2^n} \\cos 2^n \\theta + 1} \\nonumber\\\\ & =& \\sum_{j = 0}^{n-2} \\frac{2^j x^{2^j} \\sin 2^j \\theta}{x^{2^{j + 1}} + 2 x^{2^j} \\cos 2^j \\theta + 1} + \\frac{2^{n - 1} x^{2^{n - \1}} \\sin 2^{n - 1} \\theta}{x^{2^{n}} + 2 x^{2^{n - 1}} \\cos 2^{n - 1} \\theta + 1} \\nonumber\\\\ && \\quad + \\frac{2^{n + 1} x^{2^n} \\sin 2^{n - 1} \\theta \\cos 2^{n - 1} \\theta}{x^{2^{n + 1}} - 4 x^{2