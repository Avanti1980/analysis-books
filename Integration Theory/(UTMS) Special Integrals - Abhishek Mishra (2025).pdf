binom{n + 1}{j} y^{j - 3} \\right\) \\right. \\\\ && \\left. \\quad - \(n + 1\) \\left\( \\frac{1}{y^2} + \\frac{n}{y} + \\frac{n\\(n - 1\)}{2} + y \\sum_{j = 3}^{n} \\binom{n}{j} y^{j - 3} \\right\) + \\frac{1}{y^2} \\right \) \\\\ && = \\lim_{y \\to 0} \\frac{n - \(n + 1\) + 1}{y^2} + \\lim_{y \\to 0} \\frac{n\(n + 1\) - \(n + 1\)n}{y} \\\\ && \\quad + \\lim_{y \\to 0} \\frac{n^2\(\n + 1\) - n\(n + 1\)\(n - 1\)}{2} \\\\ && \\quad + \\lim_{y \\to 0} y \\left\( \\sum_{j = 3}^{n + 1} n \\binom{n + 1}{j} y^{j - 3} - \\sum_{j = 3}^{n} \(n + 1\) \\binom{n}{j} y^{j - 3} \\right\) \\\\ \\eUnALT{} )/Border[0 0 0]/K 39/P 18922 0 R/Pg 56 0 R/S/P/Type/StructElem>>endobj18948 0 obj<</ActualText(\\bUnALT{} && = \\frac{n \(n + 1\)\(n - \(n - 1\)\)}{2} \\\\ && = \\frac{n \(n + 1\)}{2}. \\eUnALT{} )/Border[0 0 0]/K 2/P 18922 0 R/Pg 59 0 R/S/P/Type/StructElem>>endobj18949 0 obj<</K 4/P 18922 0 R/Pg 59 0 R/S/P/Type/StructElem>>endobj18950 0 obj<</K[5 19158 0 R 8 19159 0 R 11]/P 18922 0 R/Pg 59 0 R/S/P/Type/StructElem>>endobj18951 0 obj<</ActualText(\\bUnALT{}\\label{eq:1.5} \\sum_{j = 1}^n \(2j - 1\) = 1 + 3 + 5 + \\cdots + 2n - 1 = n^2.\\eUnALT{} )/Border[0 0 0]/K 12/P 18922 0 R/Pg 59 0 R/S/P/Type/StructElem>>endobj18952 0 obj<</K[15 19157 0 R 18]/P 18922 0 R/Pg 59 0 R/S/P/Type/StructElem>>endobj18953 0 obj<</ActualText(\\bALT{}\\label{eq:1.6} \\sum_{j = 1}^n x^{2j - 1} = \\frac{x^{2n + 1} - x}{x^2 - 1}.\\eALT{} )/Border[0 0 0]/K 19/P 18922 0 R/Pg 59 0 R/S/P/Type/StructElem>>endobj18954 0 obj<</K 22/P 18922 0 R/Pg 59 0 R/S/P/Type/StructElem>>endobj18955 0 obj<</K[23 19154 0 R 25 19155 0 R 28]/P 18922 0 R/Pg 59 0 R/S/P/Type/StructElem>>endobj18956 0 obj<</ActualText(\\bALT{}\\label{eq:1.7} \\begin{aligned} \\sum_{j = 1}^n \(2j - 1\) x^{2j-2} & = \\frac{\\left\( \(2n + 1\) x^{2n} - 1 \\right\) \\left\( x^2 - 1 \\right\) - 2x \\left\( x^{2n + 1} - x \\right\)}{ \\left\( x^2 - 1 \\right\)^2} \\\\ & = \\frac{\(2n - 1\) x\^{2n + 2} - \(2n + 1\) x^{2n} +x^2 +