^n \\frac{\(1 - t/n\)^n}{t} \\, dt \\\\ & = \\int_0^1 \\frac{1 - \(1 - t\/n\)^n}{t} \\, dt + \\log n - \\int_1^n \\frac{\(1 - t/n\)^n}{t} \\, dt \\\\ \\implies & H\(n\) - \\log n = \\int_0^1 \\frac{1 - \(1 - t/n\)^n}{t} \\, dt - \\int_1^n \\frac{\(1 - t/n\)^n}{t} \\, dt. \\end{aligned}\\eALT{} )/Border[0 0 0]/K 4/P 11589 0 R/Pg 868 0 R/S/P/Type/StructElem>>endobj11592 0 obj<</K 7/P 11589 0 R/Pg 868 0 R/S/P/Type/StructElem>>endobj11593 0 obj<</K[8 11594 0 R 11 11595 0 R 13 11596 0 R 15]/P 11589 0 R/Pg 868 0 R/S/P/Type/StructElem>>endobj11594 0 obj<</ActualText(n \\to \\infty)/K 9/P 11593 0 R/Pg 868 0 R/S/Span/Type/StructElem>>endobj11595 0 obj<</K 11598 0 R/P 11593 0 R/S/Reference/Type/StructElem>>endobj11596 0 obj<</K 11597 0 R/P 11593 0 R/S/Reference/Type/StructElem>>endobj11597 0 obj<</Alt(Please refer Formula 3.3 your for more information)/K[<</Obj 4329 0 R/Type/OBJR>>14]/P 11596 0 R/Pg 868 0 R/S/Link/Type/StructElem>>endobj11598 0 obj<</Alt(Please refer Formula 1.11 your for more information)/K[<</Obj 4338 0 R/Type/OBJR>>12]/P 11595 0 R/Pg 868 0 R/S/Link/Type/StructElem>>endobj11599 0 obj<</Alt(Footnote )/K 5/P 11339 0 R/Pg 863 0 R/S/Lbl/Type/StructElem>>endobj11600 0 obj<</K[11601 0 R 11602 0 R]/P 11339 0 R/S/LBody/Type/StructElem>>endobj11601 0 obj<</K[6 11603 0 R 8]/P 11600 0 R/Pg 863 0 R/S/P/Type/StructElem>>endobj11602 0 obj<</ActualText(\\bUnALT{} \\begin{aligned} \\int_0^1 \\frac{1 - \(1 - t\)^n}{t} \\, dt & = \\int_0^1 \\left\( 1 - \\sum_{j = 0}^n \(-1\)^j t^j \\binom{n}{j} \\right\) \\, \\frac{dt}{t} \\\\ & = \\int_0^1 \\left\( \\sum_{j = 1}^n \(-1\)^{j - 1} t^{j - 1} \\binom{n}{j} \\\right\) \\, dt \\\\ & = \\left. \\sum_{j = 1}^n \\frac{\(-1\)^{j - 1} t^j}{j} \\binom{n}{j} \\right |_0^1 \\\\ & = \\sum_{j = 1}^n \\frac{\(-1\)^{j - 1}}{j} \\binom{n}{j} \\\\ & = \\sum_{j = 1}^n \\frac{1}{j} \\\\ & = H\(n\). \\end{aligned}\\eUnALT{} )/Border[0 0 0]/K 9/P 11600 0 R/Pg 863 0 R/S/P/Type/StructElem>>endobj11603 0 obj<</K 