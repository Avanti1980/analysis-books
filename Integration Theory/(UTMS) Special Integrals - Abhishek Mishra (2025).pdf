} a_{2j}x^{2j} + \\sum_{j = 0}^{\\infty} a_{2j}x^{2j} \\sum_{k = 0}^{j - 1} \\left\( \\binom{2j}{k} e^{ik \\theta} e^{-i\(2j - k\) \\theta} \\right. \\\\ & \\quad \\left. + \\binom{2j}{2j - k} e^{i\(2j - k\) \\theta} e^{-ik \\theta} \\rig\ht\) + \\sum_{j = 0}^{\\infty} a_{2j + 1}x^{2j + 1} \\sum_{k = 0}^{j} \\left\( \\binom{2j + 1}{k} e^{ik \\theta} e^{-i\(2j + 1 - k\) \\theta} \\right. \\\\ & \\quad \\left. + \\binom{2j + 1}{2j + 1 - k} e^{i\(2j + 1 - k\) \\theta} e^{-ik \\theta} \\right\)\ \\\\ & = \\sum_{j = 0}^{\\infty}\\binom{2j}{j} a_{2j}x^{2j} + \\sum_{j = 0}^{\\infty} a_{2j}x^{2j} \\sum_{k = 0}^{j - 1} \\binom{2j}{k} \\left\( e^{-i\(2j - 2k\) \\theta} + e^{i\(2j - 2k\) \\theta} \\right\) \\\\ & \\quad + \\sum_{j = 0}^{\\infty} a_{2j \+ 1}x^{2j + 1} \\sum_{k = 0}^{j} \\binom{2j + 1}{k} \\left\( e^{-i\(2j - 2k + 1\) \\theta} + e^{i\(2j - 2k + 1\) \\theta} \\right\) \\\\ & = \\sum_{j = 0}^{\\infty}\\binom{2j}{j} a_{2j}x^{2j} + 2 \\sum_{j = 0}^{\\infty} a_{2j}x^{2j} \\sum_{k = 0}^{j - 1} \\\binom{2j}{k} \\cos \(2j - 2k\) \\theta \\\\ & \\quad + 2 \\sum_{j = 0}^{\\infty} a_{2j + 1}x^{2j + 1} \\sum_{k = 0}^{j} \\binom{2j + 1}{k} \\cos \(2j - 2k + 1\) \\theta. \\end{aligned}\\eALT{} )/Border[0 0 0]/K 17/P 15207 0 R/Pg 326 0 R/S/P/Type/StructElem>>endobj15279 0 obj<</K 20/P 15207 0 R/Pg 326 0 R/S/P/Type/StructElem>>endobj15280 0 obj<</K[21 16157 0 R 23 16158 0 R 26 16159 0 R 29 16160 0 R 32 16161 0 R 35 16162 0 R 37]/P 15207 0 R/Pg 326 0 R/S/P/Type/StructElem>>endobj15281 0 obj<</ActualText(\\bUnALT{} \\begin{aligned} & \\frac{1}{\\pi} \\int_0^{\\pi} f \\left\( 2 x \\cos \\theta \\right\) \\, d \\theta = \\frac{1}{\\pi} \\int_0^{\\pi} \\left\( \\sum_{j = 0}^{\\infty}\\binom{2j}{j} a_{2j}x^{2j} \\right\) \\, d \\theta \\\\ & \\quad + \\frac{1\}{\\pi} \\int_0^{\\pi} \\left\( 2 \\sum_{j = 0}^{\\infty} a_{2j}x^{2j} \\sum_{k = 0}^{j - 1} \\binom{2j}{k} \\cos \(2j - 2k\) \\theta \\right\) \\, d \\theta \\\\ & \\quad + \\frac{1}{\\pi} \\int_0^{\\pi} \\left\( 