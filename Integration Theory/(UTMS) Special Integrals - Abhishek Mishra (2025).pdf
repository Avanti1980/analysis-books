 + j} & = \\pi \\sum_{j = 0}^\\infty \\frac{ \\displaystyle \\prod_{k = 0}^{j - 1} \(y - k\)}{j! x^j} \\cdot \\frac{\\displaystyle \\prod_{k = 0}^{n + j - 1} \(y - k\)}{\(n + j\)! x^{n + j}} \\\\\ & = \\int_0^\\pi \\left\( 1 + \\frac{e^{i \\theta}}{x} \\right\)^y \\left\( 1 + \\frac{e^{-i \\theta}}{x} \\right\)^y \\cos n \\theta \\, d \\theta \\\\ & = \\int_0^\\pi \\left\( 1 + \\frac{\\cos \\theta}{x} + \\frac{i \\sin \\theta}{x} \\right\)^y \\l\eft\( 1 + \\frac{\\cos \\theta}{x} - \\frac{i \\sin \\theta}{x} \\right\)^y \\cos n \\theta \\, d \\theta \\\\ & = \\int_0^\\pi \\left\( 1 + \\frac{1}{x^2} + \\frac{2 \\cos \\theta}{x} \\right\)^y \\cos n \\theta \\, d \\theta. \\end{aligned}\\eUnALT{} )/Border[0 0 0]/K 32/P 10704 0 R/Pg 963 0 R/S/P/Type/StructElem>>endobj10707 0 obj<</K 10710 0 R/P 10705 0 R/S/Reference/Type/StructElem>>endobj10708 0 obj<</ActualText(f\(z\) = \\left\( 1 + z / x \\right\)^y)/K 26/P 10705 0 R/Pg 963 0 R/S/Span/Type/StructElem>>endobj10709 0 obj<</ActualText(\(x, y, n\) \\in \(1, \\infty\) \\times \\mathbb{R} \\times \(\\mathbb{N} - 1\))/K 29/P 10705 0 R/Pg 963 0 R/S/Span/Type/StructElem>>endobj10710 0 obj<</Alt(Please refer Formula 2.30 your for more information)/K[<</Obj 4780 0 R/Type/OBJR>>24]/P 10707 0 R/Pg 963 0 R/S/Link/Type/StructElem>>endobj10711 0 obj<</Alt(Footnote )/K 17/P 9655 0 R/Pg 963 0 R/S/Lbl/Type/StructElem>>endobj10712 0 obj<</K 10713 0 R/P 9655 0 R/S/LBody/Type/StructElem>>endobj10713 0 obj<</K[18 10714 0 R 21]/P 10712 0 R/Pg 963 0 R/S/P/Type/StructElem>>endobj10714 0 obj<</ActualText(n = 0)/K 19/P 10713 0 R/Pg 963 0 R/S/Span/Type/StructElem>>endobj10715 0 obj<</Alt(Footnote )/K 2/P 9654 0 R/Pg 963 0 R/S/Lbl/Type/StructElem>>endobj10716 0 obj<</K[10717 0 R 10718 0 R]/P 9654 0 R/S/LBody/Type/StructElem>>endobj10717 0 obj<</K[3 10719 0 R 5 10720 0 R 8 10721 0 R 11 10722 0 R 13]/P 10716 0 R/Pg 963 0 R/S/P/Type/StructElem>>endobj10718 0 obj<</ActualText(\\bUnALT{} \\begin{aligned} & \\pi \\