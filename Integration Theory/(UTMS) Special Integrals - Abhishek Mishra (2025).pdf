^{2^{n \- 1}}}{x^{2^{n - 1}} + y^{2^{n - 1}}} + \\frac{2^n y^{2^n}}{\\left\( x^{2^{n - 1}} - y^{2^{n - 1}} \\right\) \\left\( x^{2^{n - 1}} + y^{2^{n - 1}} \\right\)} \\nonumber\\\\ & = \\sum_{j = 0}^{n-2} \\frac{2^j y^{2^j}}{x^{2^j} + y^{2^j}} + \\frac{2^{n - 1}\ y^{2^{n - 1}}}{x^{2^{n - 1}} + y^{2^{n - 1}}} + \\frac{2^{n - 1} y^{2^{n - 1}}}{x^{2^{n - 1}} - y^{2^{n - 1}}} - \\frac{2^{n - 1} y^{2^{n - 1}}}{x^{2^{n - 1}} + y^{2^{n - 1}}} \\nonumber\\\\ & = \\sum_{j = 0}^{n-2} \\frac{2^j y^{2^j}}{x^{2^j} + y^{2^j}} \+ \\frac{2^{n - 1} y^{2^{n - 1}}}{x^{2^{n - 1}} - y^{2^{n - 1}}} \\nonumber\\\\ & = f\(x, y, n - 1\).\\eALT{} )/Border[0 0 0]/K 2/P 12426 0 R/Pg 771 0 R/S/P/Type/StructElem>>endobj12431 0 obj<</ActualText(\\bALT{}\\bALT{}\\label{eq:18.5} f\(x, y, n\) & = \\sum_{j = 0}^{n-1} \\frac{2^j y^{2^j}}{x^{2^j} + y^{2^j}} + \\frac{2^n y^{2^n}}{x^{2^n} - y^{2^n}} \\nonumber\\\\ & = \\sum_{j = 0}^{n-2} \\frac{2^j y^{2^j}}{x^{2^j} + y^{2^j}} + \\frac{2^{n - 1} y^{2^{n \- 1}}}{x^{2^{n - 1}} + y^{2^{n - 1}}} + \\frac{2^n y^{2^n}}{\\left\( x^{2^{n - 1}} - y^{2^{n - 1}} \\right\) \\left\( x^{2^{n - 1}} + y^{2^{n - 1}} \\right\)} \\nonumber\\\\ & = \\sum_{j = 0}^{n-2} \\frac{2^j y^{2^j}}{x^{2^j} + y^{2^j}} + \\frac{2^{n - 1}\ y^{2^{n - 1}}}{x^{2^{n - 1}} + y^{2^{n - 1}}} + \\frac{2^{n - 1} y^{2^{n - 1}}}{x^{2^{n - 1}} - y^{2^{n - 1}}} - \\frac{2^{n - 1} y^{2^{n - 1}}}{x^{2^{n - 1}} + y^{2^{n - 1}}} \\nonumber\\\\ & = \\sum_{j = 0}^{n-2} \\frac{2^j y^{2^j}}{x^{2^j} + y^{2^j}} \+ \\frac{2^{n - 1} y^{2^{n - 1}}}{x^{2^{n - 1}} - y^{2^{n - 1}}} \\nonumber\\\\ & = f\(x, y, n - 1\).\\eALT{} )/Border[0 0 0]/K 3/P 12426 0 R/Pg 771 0 R/S/P/Type/StructElem>>endobj12432 0 obj<</K 6/P 12426 0 R/Pg 771 0 R/S/P/Type/StructElem>>endobj12433 0 obj<</K[9 12435 0 R 11 12436 0 R 14]/P 12426 0 R/Pg 771 0 R/S/P/Type/StructElem>>endobj12434 0 obj<</ActualText(\\bUnALT{} \\begin{aligned} f\(x, y, n\) & = f\(x, y, 1\) \\\\ & = \\frac{y}{x + y} + \\frac{2 y^2}{x^2 - y^2} \\\\ & = \\frac{y}{x + y} + \\frac{2 y^2}{\(x - y\) \(x + y\)} \\\\ & = \\frac{y}{x + y} + \\frac{y}{x - y} - \\frac{y}{x + y} \\\\ & = \\frac{y\}{x - y}. \\end{aligned}\\eUnALT{} )/Border[0 0 0]/K 15/P 12426 0 R/Pg 771 0 R/S/P/Type/StructElem>>endobj12435 0 obj<</K 12097 0 R/P 12433 0 R/S/Reference/Type/StructElem>>endobj12436 0 obj<</ActualText(n - 1)/K 12/P 12433 0 R/Pg 771 0 R/S/Span/Type/StructElem>>endobj12437 0 obj<</Alt(Footnote )/K 23/P 12239 0 R/Pg 765 0 R/S/Lbl/Type/StructElem>>endobj12438 0 obj<</K[12439 0 R 12440 0 R 12441 0 R 12442 0 R 12443 0 R 12444 0 R 12445 0 R 12446 0 R]/P 12239 0 R/S/LBody/Type/StructElem>>endobj12439 0 obj<</K 24/P 12438 0 R/Pg 765 0 R/S/P/Type/StructElem>>endobj12440 0 obj<</ActualText(\\bUnALT{} f\(x, y, n\) = \\sum_{j = 0}^{n-1} \\frac{2^j x^{2^j} \\left\( y^{2^{j + 1}} - 1 \\right\)}{\\left\( x^{2^j} + y^{2^j} \\right\) \\left\( x^{2^j} y^{2^j} + 1 \\right\)} + \\frac{2^n x^{2^n} \\left\( y^{2^{n + 1}} - 1 \\right\)}{\\left\( x^{2^n}\ - y^{2^n} \\right\) \\left\( x^{2^n} y^{2^n} - 1 \\right\)}.\\eUnALT{} )/Border[0 0 0]/K 25/P 12438 0 R/Pg 765 0 R/S/P/Type/StructElem>>endobj12441 0 obj<</K 27/P 12438 0 R/Pg 765 0 R/S/P/Type/StructElem>>endobj12442 0 obj<</ActualText(\\bALT{}\\bALT{}\\label{eq:18.4} & f\(x, y, n\) = \\sum_{j = 0}^{n-1} \\frac{2^j x^{2^j} \\left\( y^{2^{j + 1}} - 1 \\right\)}{\\left\( x^{2^j} + y^{2^j} \\right\) \\left\( x^{2^j} y^{2^j} + 1 \\right\)} + \\frac{2^n x^{2^n} \\left\( y^{2^{n + 1}} - 1 \\r\ight\)}{\\left\( x^{2^n} - y^{2^n} \\right\) \\left\( x^{2^n} y^{2^n} - 1 \\right\)} \\nonumber\\\\ & = \\sum_{j = 0}^{n-2} \\frac{2^j x^{2^j} \\left\( y^{2^{j + 1}} - 1 \\right\)}{\\left\( x^{2^j} + y^{2^j} \\right\) \\left\( x^{2^j} y^{2^j} + 1 \\right\)\} + \\frac{2^{n - 1} x^{2^{n - 1}} \\left\( y^{2^{n}} - 1 \\right\)}{\\left\( x^{2^{n - 1}} + y^{2^{n - 1}} \\right\) \\left\( x^{2^{n - 1}} y^{2^{n - 1}} + 1 \\right\)} \\nonumber\\\\ & \\quad + \\frac{2^n x^{2^n} \\left\( y^{2^{n + 1}} - 1 \\right\)}{\\\left\( x^{2^{n - 1}} - y^{2^{n - 1}} \\right\) \\left\( x^{2^{n - 1}} y^{2^{n - 1}} - 1 \\right\) \\left\( x^{2^{n - 1}} + y^{2^{n - 1}} \\right\) \\left\( x^{2^{n - 1}} y^{2^{n - 1}} + 1 \\right\)} \\nonumber\\\\ & = \\sum_{j = 0}^{n-2} \\frac{2^j x^{2^j\} \\left\( y^{2^{j + 1}} - 1 \\right\)}{\\left\( x^{2^j} + y^{2^j} \\right\) \\left\( x^{2^j} y^{2^j} + 1 \\right\)} + \\frac{2^{n - 1} x^{2^{n - 1}} \\left\( y^{2^{n}} - 1 \\right\)}{\\left\( x^{2^{n - 1}} + y^{2^{n - 1}} \\right\) \\left\( x^{2^{n - 1}}\ y^{2^{n - 1}} + 1 \\right\)} \\nonumber\\\\ & \\quad + \\frac{2^{n - 1} x^{2^{n - 1}} \\left\( y^{2^{n}} - 1 \\right\)}{\\left\( x^{2^{n - 1}} - y^{2^{n - 1}} \\right\) \\left\( x^{2^{n - 1}} y^{2^{n - 1}} - 1 \\right\)} - \\frac{2^{n - 1} x^{2^{n - 1}} \\\left\( y^{2^{n}} - 1 \\right\)}{\\left\( x^{2^{n - 1}} + y^{2^{n - 1}} \\right\) \\left\( x^{2^{n - 1}} y^{2^{n - 1}} + 1 \\right\)} \\nonumber\\\\ & = \\sum_{j = 0}^{n-2} \\frac{2^j x^{2^j} \\left\( y^{2^{j + 1}} - 1 \\right\)}{\\left\( x^{2^j} + y^{2^\j} \\right\) \\left\( x^{2^j} y^{2^j} + 1 \\right\)} + \\frac{2^{n - 1} x^{2^{n - 1}} \\left\( y^{2^{n}} - 1 \\right\)}{\\left\( x^{2^{n - 1}} - y^{2^{n - 1}} \\right\) \\left\( x^{2^{n - 1}} y^{2^{n - 1}} - 1 \\right\)} \\nonumber\\\\ & = f\(x, y, n - 1\)\.\\eALT{} )/Border[0 0 0]/K 2/P 12438 0 R/Pg 768 0 R/S/P/Type/StructElem>>endobj12443 0 obj<</ActualText(\\bALT{}\\bALT{}\\label{eq:18.4} & f\(x, y, n\) = \\sum_{j = 0}^{n-1} \\frac{2^j x^{2^j} \\left\( y^{2^{j + 1}} - 1 \\right\)}{\\left\( x^{2^j} + y^{2^j} \\right\) \\left\( x^{2^j} y^{2^j} + 1 \\right\)} + \\frac{2^n x^{2^n} \\left\( y^{2^{n + 1}} - 1 \\r\ight\)}{\\left\( x^{2^n} - y^{2^n} \\right\) \\left\( x^{2^n} y^{2^n} - 1 \\right\)} \\nonumber\\\\ & = \\sum_{j = 0}^{n-2} \\frac{2^j x^{2^j} \\left\( y^{2^{j + 1}} - 1 \\right\)}{\\left\( x^{2^j} + y^{2^j} \\right\) \\left\( x^{2^j} y^{2^j} + 1 \\right\)\} + \\frac{2^{n - 1} x^{2^{n - 1}} \\left\( y^{2^{n}} - 1 \\right\)}{\\left\( x^{2^{n - 1}} + y^{2^{n - 1}} \\right\) \\left\( x^{2^{n - 1}} y^{2^{n - 1}} + 1 \\right\)} \\nonumber\\\\ & \\quad + \\frac{2^n x^{2^n} \\left\( y^{2^{n + 1}} - 1 \\right\)}{\\\left\( x^{2^{n - 1}} - y^{2^{n - 1}} \\right\) \\left\( x^{2^{n - 1}} y^{2^{n - 1}} - 1 \\right\) \\left\( x^{2^{n - 1}} + y^{2^{n - 1}} \\right\) \\left\( x^{2^{n - 1}} y^{2^{n - 1}} + 1 \\right\)} \\nonumber\\\\ & = \\sum_{j = 0}^{n-2} \\frac{2^j x^{2^j\} \\left\( y^{2^{j + 1}} - 1 \\right\)}{\\left\( x^{2^j} + y^{2^j} \\right\) \\left\( x^{2^j} y^{2^j} + 1 \\right\)} + \\frac{2^{n - 1} x^{2^{n - 1}} \\left\( y^{2^{n}} - 1 \\right\)}{\\left\( x^{2^{n - 1}} + y^{2^{n - 1}} \\right\) \\left\( x^{2^{n - 1}}\ y^{2^{n - 1}} + 1 \\right\)} \\nonumber\\\\ & \\quad + \\frac{2^{n - 1} x^{2^{n - 1}} \\left\( y^{2^{n}} - 1 \\right\)}{\\left\( x^{2^{n - 1}} - y^{2^{n - 1}} \\right\) \\left\( x^{2^{n - 1}} y^{2^{n - 1}} - 1 \\right\)} - \\frac{2^{n - 1} x^{2^{n - 1}} \\\left\( y^{2^{n}} - 1 \\right\)}{\\left\( x^{2^{n - 1}} + y^{2^{n - 1}} \\right\) \\left\( x^{2^{n - 1}} y^{2^{n - 1}} + 1 \\right\)} \\nonumber\\\\ & = \\sum_{j = 0}^{n-2} \\frac{2^j x^{2^j} \\left\( y^{2^{j + 1}} - 1 \\right\)}{\\left\( x^{2^j} + y^{2^\j} \\right\) \\left\( x^{2^j} y^{2^j} + 1 \\right\)} + \\frac{2^{n - 1} x^{2^{n - 1}} \\left\( y^{2^{n}} - 1 \\right\)}{\\left\( x^{2^{n - 1}} - y^{2^{n - 1}} \\right\) \\left\( x^{2^{n - 1}} y^{2^{n - 1}} - 1 \\right\)} \\nonumber\\\\ & = f\(x, y, n - 1\)\.\\eALT{} )/Border[0 0 0]/K 3/P 12438 0 R/Pg 768 0 R/S/P/Type/StructElem>>endobj12444 0 obj<</K 6/P 12438 0 R/Pg 768 0 R/S/P/Type/StructElem>>endobj12445 0 obj<</K[9 12447 0 R 11 12448 0 R 14]/P 12438 0 R/Pg 768 0 R/S/P/Type/StructElem>>endobj12446 0 obj<</ActualText(\\bUnALT{} \\begin{aligned} f\(x, y, n\) & = f\(x, y, 1\) \\\\ & = \\frac{x \\left\( y^2 - 1 \\right\)}{\(x + y\) \(xy + 1\)} + \\frac{2 x^2 \\left\( y^4 - 1 \\right\)}{\\left\( x^2 - y^2 \\right\) \\left\( x^2 y^2 - 1 \\right\)} \\\\ & = \\frac{x \\left\(\ y^2 - 1 \\right\)}{\(x + y\) \(xy + 1\)} + \\frac{2 x^2 \\left\( y^4 - 1 \\right\)}{\\left\( x - y \\right\) \\left\( x y - 1 \\right\) \\left\( x + y \\right\) \\left\( x y + 1 \\right\)} \\\\ & = \\frac{x \\left\( y^2 - 1 \\right\)}{\(x + y\) \(xy + 1\)\} + \\frac{x \\left\( y^2 - 1 \\right\)}{\(x - y\) \(xy - 1\)} - \\frac{x \\left\( y^2 - 1 \\right\)}{\(x + y\) \(xy + 1\)} \\\\ & = \\frac{x \\left\( y^2 - 1 \\right\)}{\(x - y\) \(xy - 1\)}. \\end{aligned}\\eUnALT{} )/Border[0 0 0]/K 15/P 12438 0 R/Pg 768 0 R/S/P/Type/StructElem>>endobj12447 0 obj<</K 12449 0 R/P 12445 0 R/S/Reference/Type/StructElem>>endobj12448 0 obj<</ActualText(n - 1)/K 12/P 12445 0 R/Pg 768 0 R/S/Span/Type/StructElem>>endobj12449 0 obj<</Alt(Please refer Formula 7.39 your for more information)/K[<</Obj 4082 0 R/Type/OBJR>>10]/P 12447 0 R/Pg 768 0 R/S/Link/Type/StructElem>>endobj12450 0 obj<</Alt(Footnote )/K 2/P 12238 0 R/Pg 765 0 R/S/Lbl/Type/StructElem>>endobj12451 0 obj<</K[12452 0 R 12453 0 R 12454 0 R 12455 0 R 12456 0 R 12457 0 R 12458 0 R 12459 0 R]/P 12238 0 R/S/LBody/Type/StructElem>>endobj12452 0 obj<</K 3/P 12451 0 R/Pg 765 0 R/S/P/Type/StructElem>>endobj12453 0 obj<</ActualText(\\bUnALT{} f\(x, n\) = \\sum_{j = 0}^{n-1} \\frac{2^{2j} x^{2^j}}{\(x^{2^j} + 1\)^2} + \\frac{2^{2n} x^{2^n}}{\(x^{2^n} - 1\)^2}.\\eUnALT{} )/Border[0 0 0]/K 4/P 12451 0 R/Pg 765 0 R/S/P/Type/StructElem>>endobj12454 0 obj<</K 6/P 12451 0 R/Pg 765 0 R/S/P/Type/StructElem>>endobj12455 0 obj<</ActualText(\\bALT{}\\bALT{}\\label{eq:18.3} f\(x, n\) & =&\\sum_{j = 0}^{n-1} \\frac{2^{2j} x^{2^j}}{\\left\( x^{2^j} + 1 \\right\)^2} + \\frac{2^{2n} x^{2^n}}{\\left\( x^{2^n} - 1 \\right\)^2} \\nonumber\\\\ & =& \\sum_{j = 0}^{n-2} \\frac{2^{2j} x^{2^j}}{\\left\( \x^{2^j} + 1 \\right\)^2} + \\frac{2^{2n - 2} x^{2^{n - 1}}}{\\left\( x^{2^{n - 1}} + 1 \\right\)^2} + \\frac{2^{2n} x^{2^{n}}}{\\left\( x^{2^{n - 1}} - 1 \\right\)^2 \\left\( x^{2^{n - 1}} + 1 \\right\)^2} \\nonumber\\\\ & =& \\sum_{j = 0}^{n-2} \\frac{2^\{2j} x^{2^j}}{\\left\( x^{2^j} + 1 \\right\)^2} + \\frac{2^{2n - 2} x^{2^{n - 1}}}{\\left\( x^{2^{n - 1}} + 1 \\right\)^2} + \\frac{2^{2n - 2} x^{2^{n - 1}}}{\\left\( x^{2^{n - 1}} - 1 \\right\)^2} - \\frac{2^{2n - 2} x^{2^{n - 1}}}{\\left\( x^{2^{n - 1}}\ + 1 \\right\)^2} \\nonumber\\\\ & =& \\sum_{j = 0}^{n-2} \\frac{2^{2j} x^{2^j}}{\\left\( x^{2^j} + 1 \\right\)^2} + \\frac{2^{2n - 2} x^{2^{n - 1}}}{\\left\( x^{2^{n - 1}} - 1 \\right\)^2} \\nonumber\\\\ & =& f\(x, n - 1\).\\eALT{} )/Border[0 0 0]/K 7/P 12451 0 R/Pg 765 0 R/S/P/Type/StructElem>>endobj12456 0 obj<</ActualText(\\bALT{}\\bALT{}\\label{eq:18.3} f\(x, n\) & =&\\sum_{j = 0}^{n-1} \\frac{2^{2j} x^{2^j}}{\\left\( x^{2^j} + 1 \\right\)^2} + \\frac{2^{2n} x^{2^n}}{\\left\( x^{2^n} - 1 \\right\)^2} \\nonumber\\\\ & =& \\sum_{j = 0}^{n-2} \\frac{2^{2j} x^{2^j}}{\\left\( \x^{2^j} + 1 \\right\)^2} + \\frac{2^{2n - 2} x^{2^{n - 1}}}{\\left\( x^{2^{n - 1}} + 1 \\right\)^2} + \\frac{2^{2n} x^{2^{n}}}{\\left\( x^{2^{n - 1}} - 1 \\right\)^2 \\left\( x^{2^{n - 1}} + 1 \\right\)^2} \\nonumber\\\\ & =& \\sum_{j = 0}^{n-2} \\frac{2^\{2j} x^{2^j}}{\\left\( x^{2^j} + 1 \\right\)^2} + \\frac{2^{2n - 2} x^{2^{n - 1}}}{\\left\( x^{2^{n - 1}} + 1 \\right\)^2} + \\frac{2^{2n - 2} x^{2^{n - 1}}}{\\left\( x^{2^{n - 1}} - 1 \\right\)^2} - \\frac{2^{2n - 2} x^{2^{n - 1}}}{\\left\( x^{2^{n - 1}}\ + 1 \\right\)^2} \\nonumber\\\\ & =& \\sum_{j = 0}^{n-2} \\frac{2^{2j} x^{2^j}}{\\left\( x^{2^j} + 1 \\right\)^2} + \\frac{2^{2n - 2} x^{2^{n - 1}}}{\\left\( x^{2^{n - 1}} - 1 \\right\)^2} \\nonumber\\\\ & =& f\(x, n - 1\).\\eALT{} )/Border[0 0 0]/K 8/P 12451 0 R/Pg 765 0 R/S/P/Type/StructElem>>endobj12457 0 obj<</K 11/P 12451 0 R/Pg 765 0 R/S/P/Type/StructElem>>endobj12458 0 obj<</K[14 12460 0 R 16 12461 0 R 19]/P 12451 0 R/Pg 765 0 R/S/P/Type/StructElem>>endobj12459 0 obj<</ActualText(\\bUnALT{} \\begin{aligned} f\(x, n\) & = f\(x, 1\) \\\\ & = \\frac{x}{\(x + 1\)^2} + \\frac{4 x^2}{\\left\( x^2 - 1 \\right\)^2} \\\\ & = \\frac{x}{\(x + 1\)^2} + \\frac{4 x^2}{\(x - 1\)^2 \(x + 1\)^2} \\\\ & = \\frac{x}{\(x + 1\)^2} + \\frac{x}{\(x - 1\)\^2} - \\frac{x}{\(x + 1\)^2} \\\\ & = \\frac{x}{\(x - 1\)^2}. \\end{aligned}\\eUnALT{} )/Border[0 0 0]/K 20/P 12451 0 R/Pg 765 0 R/S/P/Type/StructElem>>endobj12460 0 obj<</K 12462 0 R/P 12458 0 R/S/Reference/Type/StructElem>>endobj12461 0 obj<</ActualText(n - 1)/K 17/P 12458 0 R/Pg 765 0 R/S/Span/Type/StructElem>>endobj12462 0 obj<</Alt(Please refer Formula 7.39 your for more information)/K[<</Obj 4081 0 R/Type/OBJR>>15]/P 12460 0 R/Pg 765 0 R/S/Link/Type/StructElem>>endobj12463 0 obj<</Alt(Footnote )/K 25/P 12237 0 R/Pg 762 0 R/S/Lbl/Type/StructElem>>endobj12464 0 obj<</K[12465 0 R]/P 12237 0 R/S/LBody/Type/StructElem>>endobj12465 0 obj<</K[26 12466 0 R 29]/P 12464 0 R/Pg 762 0 R/S/P/Type/StructElem>>endobj12466 0 obj<</ActualText(y = 1)/K 27/P 12465 0 R/Pg 762 0 R/S/Span/Type/StructElem>>endobj12467 0 obj<</Alt(Footnote )/K 66/P 12236 0 R/Pg 759 0 R/S/Lbl/Type/StructElem>>endobj12468 0 obj<</K[12469 0 R 12470 0 R 12471 0 R 12472 0 R 12473 0 R 12474 0 R 12475 0 R 12476 0 R 12477 0 R 12478 0 R]/P 12236 0 R/S/LBody/Type/StructElem>>endobj12469 0 obj<</K 67/P 12468 0 R/Pg 759 0 R/S/P/Type/StructElem>>endobj12470 0 obj<</ActualText(\\bUnALT{} f\(\\theta, k\) = \\frac{1}{2^k} \\cot \\frac{1}{2^k \\theta} + \\sum_{j = k + 1}^{\\infty} \\frac{1}{2^j} \\tan \\frac{1}{2^j \\theta}.\\eUnALT{} )/Border[0 0 0]/K 68/P 12468 0 R/Pg 759 0 R/S/P/Type/StructElem>>endobj12471 0 obj<</K 1/P 12468 0 R/Pg 762 0 R/S/P/Type/StructElem>>endobj12472 0 obj<</ActualText(\\bALT{}\\label{eq:18.1} \\begin{aligned} f\(\\theta, k\) & = \\frac{1}{2^k} \\cot \\frac{1}{2^k \\theta} + \\sum_{j = k + 1}^{\\infty} \\frac{1}{2^j} \\tan \\frac{1}{2^j \\theta} \\\\ & = \\frac{1}{2^k} \\cdot \\frac{1 - \\tan^2 \\displaystyle \\frac{1}{\2^{k + 1} \\theta} }{2 \\tan \\displaystyle \\frac{1}{2^{k + 1} \\theta} } + \\frac{1}{2^{k + 1}} \\tan \\frac{1}{2^{k + 1} \\theta} + \\sum_{j = k + 2}^{\\infty} \\frac{1}{2^j} \\tan \\frac{1}{2^j \\theta} \\\\ & = \\frac{1}{2^{k + 1}} \\cot \\frac{1}{2^\{k + 1} \\theta} + \\sum_{j = k + 2}^{\\infty} \\frac{1}{2^j} \\tan \\frac{1}{2^j \\theta} \\\\ & = f\(\\theta, k + 1\). \\end{aligned}\\eALT{} )/Border[0 0 0]/K 2/P 12468 0 R/Pg 762 0 R/S/P/Type/StructElem>>endobj12473 0 obj<</K 5/P 12468 0 R/Pg 762 0 R/S/P/Type/StructElem>>endobj12474 0 obj<</K[6 12482 0 R 8 12483 0 R 11]/P 12468 0 R/Pg 762 0 R/S/P/Type/StructElem>>endobj12475 0 obj<</ActualText(\\bALT{}\\label{eq:18.2} \\begin{aligned} f\(\\theta, 0\) & = f\(\\theta, n\) \\\\ & = \\frac{1}{2^n} \\cot \\frac{1}{2^n \\theta} + \\sum_{j = n + 1}^{\\infty} \\frac{1}{2^j} \\tan \\frac{1}{2^j \\theta}. \\end{aligned}\\eALT{} )/Border[0 0 0]/K 12/P 12468 0 R/Pg 762 0 R/S/P/Type/StructElem>>endobj12476 0 obj<</K 15/P 12468 0 R/Pg 762 0 R/S/P/Type/StructElem>>endobj12477 0 obj<</K[16 12479 0 R 19 12480 0 R 21]/P 12468 0 R/Pg 762 0 R/S/P/Type/StructElem>>endobj12478 0 obj<</ActualText(\\bUnALT{} \\begin{aligned} \\cot \\frac{1}{\\theta} + \\sum_{j = 1}^{\\infty} \\frac{1}{2^j} \\tan \\frac{1}{2^j \\theta} & = \\lim_{n \\to \\infty} \\left\( \\frac{1}{2^n} \\cot \\frac{1}{2^n \\theta} + \\sum_{j = n + 1}^{\\infty} \\frac{1}{2^j} \\tan \\\frac{1}{2^j \\theta} \\right\) \\\\ & = \\lim_{n \\to \\infty} \\theta \\frac{\\displaystyle \\frac{1}{2^n \\theta}}{\\displaystyle \\tan \\frac{1}{2^n \\theta} } + \\lim_{n \\to \\infty} \\sum_{j = n + 1}^\\infty \\frac{1}{2^j} \\cdot \\frac{1}{2^j \\the\ta} \\cdot \\frac{\\displaystyle \\tan \\frac{1}{2^j \\theta}}{\\displaystyle \\frac{1}{2^j \\theta} } \\\\ & = \\theta + \\frac{1}{\\theta} \\lim_{n \\to \\infty} \\sum_{j = n + 1}^\\infty \\frac{1}{2^{2j}} \\\\ & = \\theta + \\frac{1}{\\theta} \\lim_{n \\\to \\infty} \\frac{\\displaystyle \\frac{1}{2^{2n + 2}}}{1 - \\displaystyle \\frac{1}{4}} \\\\ & = \\theta. \\end{aligned}\\eUnALT{} )/Border[0 0