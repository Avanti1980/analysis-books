2} \\right\) \\right. \\\\ \\pg{\\noalign{\\vskip4pt}} & \\qquad \\left. + e^{in \\theta} \\log \\left\( 2 \\cos^2 \\frac{\\theta}{2} - 2i \\cos \\frac{\\theta}{2} \\sin \\frac{\\theta}{2} \\right\) \\right\) \\, d \\theta \\end{aligned}\\eALT\{} )/Border[0 0 0]/K 33/P 10839 0 R/Pg 939 0 R/S/P/Type/StructElem>>endobj10842 0 obj<</K 36/P 10839 0 R/Pg 939 0 R/S/P/Type/StructElem>>endobj10843 0 obj<</ActualText(\\bUnALT{} \\begin{aligned} & = \\frac{1}{2} \\int_0^\\pi \\left\( e^{-in \\theta} \\left\( \\log \\left\( 2 \\cos \\frac{\\theta}{2} \\right\) + \\log \\left\( \\cos \\frac{\\theta}{2} + i \\sin \\frac{\\theta}{2} \\right\) \\right\) \\right. \\\\ \\pg{\\\noalign{\\vskip4pt}} & \\qquad \\left. + e^{in \\theta} \\left\( \\log \\left\( 2 \\cos \\frac{\\theta}{2} \\right\) + \\log \\left\( \\cos \\frac{\\theta}{2} - i \\sin \\frac{\\theta}{2} \\right\) \\right\) \\right\) \\, d \\theta \\\\ \\pg{\\noalign{\\v\skip4pt}} & = \\int_0^\\pi \\left\( \\frac{e^{-in \\theta} + e^{in \\theta}}{2} \\log \\left\( 2 \\cos \\frac{\\theta}{2} \\right\) + \\frac{e^{-in \\theta} \\log e^{i \\theta / 2} + e^{in \\theta} \\log e^{-i \\theta / 2}}{2} \\right\) \\, d \\theta \\\\\ \\pg{\\noalign{\\vskip4pt}} & = \\int_0^\\pi \\left\( \\cos n \\theta \\log \\left\( 2 \\cos \\frac{\\theta}{2} \\right\) \\right. \\\\ & \\quad \\left. + \\frac{\\displaystyle i \\frac{\\theta}{2} \(\\cos n \\theta - i \\sin n \\theta\) - i \\frac{\\the\ta}{2} \(\\cos n \\theta + i \\sin n \\theta\)}{2} \\right\) \\, d \\theta \\\\ \\pg{\\noalign{\\vskip4pt}} & = \\int_0^\\pi \\left\( \\cos n \\theta \\log \\left\( 2 \\cos \\frac{\\theta}{2} \\right\) + \\frac{\\theta}{2} \\sin n \\theta \\right\) \\, d \\\theta. \\end{aligned}\\eUnALT{} )/Border[0 0 0]/K 2/P 10839 0 R/Pg 942 0 R/S/P/Type/StructElem>>endobj10844 0 obj<</K 10847 0 R/P 10840 0 R/S/Reference/Type/StructElem>>endobj10845 0 obj<</ActualText(f\(z\) = \\log\(1 + z\))/K 27/P 10840 0 R/Pg 939 0 R/S/Span/Type/StructElem>>endobj10